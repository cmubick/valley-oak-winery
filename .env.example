# Copy to .env.local for local development (LocalStack). Production values are set in terraform/main.tf.
DYNAMODB_WINES_TABLE=winery-wines
DYNAMODB_USERS_TABLE=winery-users
DYNAMODB_SETTINGS_TABLE=winery-settings
S3_BUCKET_NAME=winery-wine-images-local
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-change-me
# Shared secret the weekly EventBridge job sends to /api/instagram/refresh
INSTAGRAM_REFRESH_SECRET=local-dev-refresh-secret
